<UserControl x:Class="ExternalGameTracker.Views.ExternalGameTrackerSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="650">
    <StackPanel Margin="20">
        <TextBlock Text="Configurações do Rastreamento Externo" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" />

        <CheckBox IsChecked="{Binding Settings.EnableTracking}" 
                  Content="Habilitar rastreamento automático de jogos iniciados fora do Playnite" 
                  Margin="0,0,0,12" FontWeight="SemiBold" />

        <CheckBox IsChecked="{Binding Settings.ShowNotifications}" 
                  Content="Exibir notificações na central do Playnite ao iniciar/encerrar jogos" 
                  Margin="0,0,0,12" />

        <CheckBox IsChecked="{Binding Settings.ScanSubfolders}" 
                  Content="Escanear subpastas de 1º nível (ex: _retail_ para COD, Binaries\Win64 para Unreal Engine)" 
                  Margin="0,0,0,12" />

        <DockPanel Margin="0,0,0,15">
            <TextBlock Text="Tempo mínimo de sessão (segundos):" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox Text="{Binding Settings.MinSessionSeconds, UpdateSourceTrigger=PropertyChanged}" 
                     Width="70" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <TextBlock Text="(Evita falsos positivos com instaladores ou aberturas acidentais)" 
                       Foreground="Gray" Margin="10,0,0,0" VerticalAlignment="Center" />
        </DockPanel>

        <TextBlock Text="Lista de Palavras-Chave Ignoradas (Blacklist separada por vírgula):" 
                   FontWeight="SemiBold" Margin="0,5,0,5" />
        <TextBox Text="{Binding Settings.Blacklist, UpdateSourceTrigger=PropertyChanged}" 
                 AcceptsReturn="True" TextWrapping="Wrap" Height="70" VerticalScrollBarVisibility="Auto" />
        <TextBlock Text="Executáveis que contenham qualquer uma dessas palavras serão ignorados (ex: crash, report, unitycrashhandler, etc.)." 
                   Foreground="Gray" FontSize="11" Margin="0,4,0,15" />
    </StackPanel>
</UserControl>
