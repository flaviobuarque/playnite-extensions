<UserControl x:Class="InstallationStatusUpdater.Presentation.OrphanFoldersWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}" />
        <Style x:Key="SizeColumnTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="20">
        <DockPanel>
            <!-- Bottom Buttons -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="{DynamicResource LOCInstallation_Status_Updater_OrphanWindowOpenSelectedButton}"
                        Command="{Binding OpenSelectedCommand}"
                        MinWidth="140"
                        Margin="0,0,10,0" />
                <Button Content="{DynamicResource LOCInstallation_Status_Updater_OrphanWindowCopyPathsButton}"
                        Command="{Binding CopyPathsCommand}"
                        MinWidth="120"
                        Margin="0,0,10,0" />
                <Button Content="{DynamicResource LOCInstallation_Status_Updater_StatusUpdateResultsDialogCloseLabel}"
                        Command="{Binding CloseCommand}"
                        MinWidth="100" />
            </StackPanel>

            <!-- Top Header Card -->
            <Border DockPanel.Dock="Top"
                    Background="#2A2312"
                    BorderBrush="#D97706"
                    BorderThickness="4,1,1,1"
                    CornerRadius="6"
                    Padding="14,10"
                    Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalFolders}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#FBBF24" />
                        <TextBlock Text=" pastas órfãs encontradas "
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#FBBF24"
                                   Margin="6,0,0,2"
                                   VerticalAlignment="Bottom" />
                        <TextBlock Text="{Binding TotalWastedSpaceFormatted, StringFormat='(~{0} ocupados no disco)'}"
                                   FontSize="14"
                                   FontWeight="Normal"
                                   Foreground="#FDE68A"
                                   Margin="4,0,0,2"
                                   VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource LOCInstallation_Status_Updater_OrphanWindowDescription}"
                               FontSize="11"
                               Opacity="0.85"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- DataGrid -->
            <DataGrid ItemsSource="{Binding Folders}"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      CanUserAddRows="False" AutoGenerateColumns="False" CanUserResizeRows="True" CanUserSortColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource LOCInstallation_Status_Updater_StatusUpdateResultsWindowNameLabel}"
                                        Binding="{Binding FolderName}"
                                        Width="180"
                                        IsReadOnly="True" />
                    <DataGridTextColumn Header="{DynamicResource LOCInstallation_Status_Updater_StatusUpdaterSettingDetectionDirsLvPathLabel}"
                                        Binding="{Binding FullPath}"
                                        Width="*"
                                        IsReadOnly="True" />
                    <DataGridTextColumn Header="{DynamicResource LOCInstallation_Status_Updater_StatusUpdateResultsWindowSizeLabel}"
                                        Binding="{Binding SizeDisplay}"
                                        Width="100"
                                        ElementStyle="{StaticResource SizeColumnTextStyle}"
                                        IsReadOnly="True" />
                    <DataGridTextColumn Header="{DynamicResource LOCInstallation_Status_Updater_OrphanWindowModifiedLabel}"
                                        Binding="{Binding LastModifiedDisplay}"
                                        Width="140"
                                        IsReadOnly="True" />
                    <DataGridTemplateColumn Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{DynamicResource LOCInstallation_Status_Updater_OrphanWindowOpenButton}"
                                        Command="{Binding OpenInExplorerCommand}"
                                        Padding="6,2"
                                        Margin="4,2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
