<UserControl x:Class="InstallationStatusUpdater.Presentation.NoChangesDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="420">
    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}" />
    </UserControl.Resources>
    <Grid Margin="20,16,20,16">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Success Icon Badge -->
            <Border Width="44" Height="44" CornerRadius="22"
                    Background="#163B26" BorderBrush="#10B981" BorderThickness="1.5"
                    HorizontalAlignment="Center" Margin="0,0,0,10">
                <TextBlock Text="&#x2713;" FontSize="22" FontWeight="Bold"
                           Foreground="#34D399"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="0,-2,0,0" />
            </Border>

            <!-- Main Title -->
            <TextBlock Text="{DynamicResource LOCInstallation_Status_Updater_NoChangesTitle}"
                       FontSize="16" FontWeight="SemiBold"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       Margin="0,0,0,6" />

            <!-- Detailed Message -->
            <TextBlock Text="{DynamicResource LOCInstallation_Status_Updater_NoChangesMessage}"
                       FontSize="13" TextWrapping="Wrap"
                       MaxWidth="360"
                       Opacity="0.85"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       Margin="0,0,0,16" />

            <!-- OK Button with Countdown -->
            <Button x:Name="OkButton"
                    MinWidth="110" Height="30"
                    HorizontalAlignment="Center"
                    IsDefault="True" IsCancel="True"
                    Click="OkButton_Click" />
        </StackPanel>
    </Grid>
</UserControl>
